{
  "goal": "Meta-agent: plan, generate, execute and version sub-agent projects, driven by SkillOS on Gemma 4 31b (local via Ollama).",
  "models": [
    { "provider": "ollama", "model": "gemma4:31b", "params": { "temperature": 0.9 }, "auto": true },
    { "provider": "google", "model": "gemini-2.0-flash", "params": { "temperature": 0.9 }, "note": "optional hosted alternative" }
  ],
  "trace": {
    "provider": "skillos",
    "auto": true,
    "redact": ["sk-[A-Za-z0-9_-]+", "AI[A-Za-z0-9_\\-]{20,}", "(?i)(api[_-]?key|token|secret)\\s*[:=]\\s*\\S+"]
  },
  "state": "fluid",
  "metrics": {}
}
