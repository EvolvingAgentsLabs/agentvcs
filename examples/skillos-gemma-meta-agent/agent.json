{
  "goal": "Meta-agent: plan, generate, execute and version sub-agent projects, driven by SkillOS on Gemma 4 31b (Google AI Studio Gemini API).",
  "models": [
    { "provider": "google", "model": "gemma-4-31b-it", "params": { "temperature": 0.9 }, "auto": true, "note": "Gemma 4 31b via Google AI Studio (Gemini API)" },
    { "provider": "ollama", "model": "gemma4:31b", "params": { "temperature": 0.9 }, "note": "local fallback via Ollama" }
  ],
  "trace": {
    "provider": "skillos",
    "auto": true,
    "redact": ["sk-[A-Za-z0-9_-]+", "AI[A-Za-z0-9_\\-]{20,}", "(?i)(api[_-]?key|token|secret)\\s*[:=]\\s*\\S+"]
  },
  "state": "fluid",
  "metrics": {}
}
