# vhs tape for the eve-evolve-merge demo.
# Regenerate the gif (vhs required):  vhs examples/eve-evolve-merge/demo.tape
# Run from the agentvcs repo root so the relative path resolves.
Output examples/eve-evolve-merge/demo.gif

Set Shell bash
Set FontSize 13
Set Width 1120
Set Height 1040
Set Padding 18
Set PlaybackSpeed 1.0

Hide
Type "clear" Enter
Show

Type "bash examples/eve-evolve-merge/demo.sh"
Sleep 800ms
Enter
Sleep 9s
