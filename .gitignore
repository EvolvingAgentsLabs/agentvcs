__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.DS_Store
# never version the agentvcs metadata of the example sandboxes
examples/**/.agentvcs/
examples/**/crystal/

# demo sandboxes (regenerated by run.sh)
examples/agent-loop-demo/workdir/
examples/evolution-diagnostics/workdir/
examples/business-cases/workdir/
examples/lora-kernel/workdir/

# claude-code validation sandbox (regenerated by setup.sh)
examples/claude-code-task/sandbox/

# generated recording artifact (regenerate with vhs / make_cast.py)
examples/recording/demo.gif

# fair blind-test sandbox (regenerated by setup.sh)
examples/blind-fleet-task/sandbox/

# agent self-test sandbox (regenerated by selftest/selftest.sh)
selftest/.sandbox/

# rust
/target/

# Python SDK (crates/agentvcs-py): the extension maturin develop drops in place
crates/agentvcs-py/python/agentvcs/*.so
crates/agentvcs-py/python/agentvcs/*.pyd
# toy pipeline run output (regenerated by run_pipeline.py)
examples/toy_pipeline/workdir*/
examples/toy_pipeline/workdir-real.log
